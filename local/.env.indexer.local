# ============================================================
#  Indexer - Local dev environment
#  Points to the local passage-node container and local DB.
# ============================================================

# PostgreSQL connection (matches the postgres service in docker-compose.local.yml)
DB_URL=postgresql://indexer-passage:TheSecretOne_@postgres:5432/passage
PassageDatabaseCS=postgresql://indexer-passage:TheSecretOne_@postgres:5432/passage

# Active chain
ActiveChain=passage

# RPC nodes - points to the local passage-node container
# (service name inside Docker network)
RpcNodes=http://passage-node:26657

# Cache: disable for local dev so reindexing from 0 is fast
KeepCache=false

# Standby mode: false = indexer will sync actively
Standby=false

# Data folder inside the container
DataFolder=/home/data

# Node env
NODE_ENV=development

# Healthchecks: disabled locally
HealthchecksEnabled=false
HealthChecks_SyncBlocks=false
HealthChecks_SyncAKTPriceHistory=false
HealthChecks_SyncKeybaseInfo=false
HealthChecks_SyncProviderInfo=false
